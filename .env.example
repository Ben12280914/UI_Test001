# ─────────────────────────────────────────────────────────────
# TKG AI Reporting Agent — environment configuration
# Copy to .env.local and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────

# AI mode
#   live : call Claude for extraction / report drafting / feedback revision
#   demo : deterministic rule-based engine (no network, stable for presentations)
# If AI_MODE=live but no API key is set, the app falls back to demo and shows a warning.
AI_MODE=live

# Claude API credentials
ANTHROPIC_API_KEY=
# Corporate LLM gateway / reverse proxy in front of the Claude API (optional).
# Leave empty to call https://api.anthropic.com directly.
ANTHROPIC_BASE_URL=
# Model used for all AI steps.
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback (Claude API only). Set to "off" if your gateway rejects beta headers.
ANTHROPIC_FALLBACKS=default

# Outbound HTTP(S) proxy for the LLM call only (optional), e.g. http://proxy.company.local:8080
LLM_HTTPS_PROXY=

# Where uploaded files and the Work Memory store are kept on the server.
DATA_DIR=./data

# Inbound trigger webhook (Power Automate → POST /api/triggers/webhook).
# The webhook is disabled until a secret is set; callers send it in the `x-trigger-secret` header.
TRIGGER_WEBHOOK_SECRET=
